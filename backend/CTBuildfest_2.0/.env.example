# Environment Configuration for CTBF-AI-05 Module 1 (Resume Screening & ATS Matching)

# Application Settings
APP_NAME="CTBF-AI-05 Resume Screening Service"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Supabase PostgreSQL)
# Example: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# In development without external DB, fallback SQLite is supported: sqlite:///./screening.db
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres"
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# Groq LLM API Configuration
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"

# ATS Matching Weights (Must sum to 1.0 or 100)
ATS_WEIGHT_REQUIRED_SKILLS=0.35
ATS_WEIGHT_PREFERRED_SKILLS=0.15
ATS_WEIGHT_EXPERIENCE=0.15
ATS_WEIGHT_PROJECTS=0.15
ATS_WEIGHT_EDUCATION=0.10
ATS_WEIGHT_CERTIFICATIONS=0.05
ATS_WEIGHT_ROLE_RELEVANCE=0.05

# Upload & File Limits
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
ALLOWED_EXTENSIONS=["pdf", "docx", "json"]

# Synthetic Benchmark Settings
SYNTHETIC_POOL_SIZE=100
SYNTHETIC_BATCH_SIZE=10

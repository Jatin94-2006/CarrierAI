# OpenRouter LLM Configuration (NVIDIA Nemotron Ultra)
# Get a free key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Speech-to-Text (STT) Provider:
# Option A: "faster_whisper" -> Completely FREE, runs 100% locally on your machine without any API key or account!
# Option B: "groq" -> Groq offers a 100% FREE tier! Get a free key at: https://console.groq.com/keys
STT_PROVIDER=faster_whisper
GROQ_API_KEY=
OPENAI_API_KEY=
WHISPER_MODEL_SIZE=small

# Text-to-Speech (TTS) Provider: "edge_tts", "kokoro", or "browser"
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-GuyNeural

# Storage Directory for temporary audio cache
AUDIO_CACHE_DIR=./cache/audio

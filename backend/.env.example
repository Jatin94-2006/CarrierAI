# CareerAI Backend Environment Configuration (Optional)
# All agents operate with built-in deterministic offline engines if keys are omitted.

# Groq API Key (Optional for Llama 3 analysis & Groq Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Credentials (Optional for cloud storage; defaults to local storage if omitted)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Server Port (Render sets this automatically via $PORT)
PORT=8000
HOST=0.0.0.0

